[branches]
source = "master"
destination = "public"

[user]
name = "rt-labs bot"
email = "rtlbot@rt-labs.com"

[actions]
remove_paths = [
    ".docker",
    ".mutilatorrc",
    ".jenkins",
    ".gitmodules",
    "docs/",
    "*/cmake/",
    "*/CMakeLists.txt",
    "*/CMakePresets.json",
    "cmake/",
    "CMakeLists.txt",
    "CMakePresets.json",
    "*.cmake",
]
