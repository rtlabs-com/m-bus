{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "build/${presetName}",
            "cacheVariables": {
                "CMAKE_FIND_NO_INSTALL_PREFIX": true
            }
        },
        {
            "name": "test",
            "inherits" : "base",
            "cacheVariables": {
                "COPEN_BUILD_TESTING": true,
                "CMAKE_BUILD_TYPE": "Coverage"
            }
        },
        {
            "name": "default",
            "inherits" : "base"
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "test",
            "configurePreset": "test"
        }
    ],
    "packagePresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "generators": [
                "ZIP"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "test",
            "configurePreset": "test",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        }
    ]
}
